# --- Required ---
TELEGRAM_BOT_TOKEN=your_token_here
GEMINI_API_KEY=your_gemini_key_here

# --- Memory (Supabase) — leave blank to run without saving ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_or_secret_key

# --- Optional ---
# Gemini model used for scoring, keywords and drafting
GEMINI_MODEL=gemini-flash-latest
# Notes scoring below this get no draft (0-10)
SCORE_THRESHOLD=6
# Any random string; pass the same value as secret_token when setting the webhook
TELEGRAM_WEBHOOK_SECRET=
# Only respond to this chat id (Meera's). Blank = respond to anyone.
ALLOWED_CHAT_ID=
